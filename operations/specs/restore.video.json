{
  "schema": "cauce.operation/1",
  "id": "restore.video",
  "version": 2,
  "title": "Restore decoded video with SeedVR2",
  "kind": "decoded-video-enhancement",
  "implementation_class": "official-comfy",
  "summary": "Increase spatial definition and restore temporally coherent detail with ComfyUI's native SeedVR2 video pipeline without changing frame count or frame rate.",
  "inputs": [
    { "name": "source_video", "type": "VIDEO", "required": true },
    { "name": "scale_multiplier", "type": "FLOAT", "required": true },
    { "name": "seedvr2_model", "type": "MODEL", "required": true },
    { "name": "seedvr2_vae", "type": "VAE", "required": true }
  ],
  "outputs": [
    { "name": "restored_frames", "type": "IMAGE", "required": true },
    { "name": "source_fps", "type": "FLOAT", "required": true }
  ],
  "constraints": {
    "frame_count_change": false,
    "frame_rate_change": false,
    "temporal_model": true,
    "recommended_initial_model": "seedvr2_3b_nvfp4.safetensors",
    "recommended_color_correction": "lab",
    "recommended_steps": 1,
    "audio_handling": "outside operation"
  },
  "graph_contract": [
    { "order": 1, "owner": "vanilla-comfy", "node_type": "GetVideoComponents", "role": "decode source video and expose its original frame rate" },
    { "order": 2, "owner": "vanilla-comfy", "node_type": "ResizeImageMaskNode", "role": "resize decoded frames to the requested spatial target before restoration" },
    { "order": 3, "owner": "official-comfy", "node_type": "SeedVR2Preprocess", "role": "pad and normalize the resized frame batch for SeedVR2" },
    { "order": 4, "owner": "vanilla-comfy", "node_type": "VAEEncodeTiled", "role": "encode the padded video with the SeedVR2 VAE" },
    { "order": 5, "owner": "official-comfy", "node_type": "SeedVR2TemporalChunk", "role": "split long video latents into overlapping VRAM-bounded chunks" },
    { "order": 6, "owner": "official-comfy", "node_type": "SeedVR2Conditioning", "role": "derive the native restoration conditioning for each chunk" },
    { "order": 7, "owner": "vanilla-comfy", "node_type": "KSampler", "role": "run the one-step SeedVR2 restoration sampler over each chunk" },
    { "order": 8, "owner": "official-comfy", "node_type": "SeedVR2TemporalMerge", "role": "merge sampled chunks with overlap crossfade" },
    { "order": 9, "owner": "vanilla-comfy", "node_type": "VAEDecodeTiled", "role": "decode the restored SeedVR2 latent" },
    { "order": 10, "owner": "official-comfy", "node_type": "SeedVR2PostProcessing", "role": "align geometry and apply explicit color correction" }
  ],
  "variants": [
    {
      "id": "seedvr2-3b-nvfp4",
