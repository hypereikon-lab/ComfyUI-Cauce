      "vae_sha256": "20678548f420d98d26f11442d3528f8b8c94e57ee046ef93dbb7633da8612ca1",
      "source_revision": "673340c8a66db62b84e4099def7d01d337ae12dc",
      "license": "Apache-2.0",
      "role": "initial 32 GB VRAM production target"
    }
  ],
  "artifacts": {
    "state": "contract-only",
    "pairs": []
  },
  "evidence": {
