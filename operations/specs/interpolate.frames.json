{
  "schema": "cauce.operation/1",
  "id": "interpolate.frames",
  "version": 2,
  "title": "Interpolate decoded video frames",
  "kind": "decoded-video-enhancement",
  "implementation_class": "official-comfy-with-cauce-planning",
  "summary": "Increase decoded sample rate with ComfyUI's native endpoint-preserving RIFE or FILM interpolation while CAUCE records the exact output clock and source-anchor positions.",
  "inputs": [
    { "name": "source_video", "type": "VIDEO", "required": true },
    { "name": "source_frame_count", "type": "INT", "required": true },
    { "name": "source_fps", "type": "FLOAT", "required": true },
    { "name": "multiplier", "type": "INT", "required": true }
  ],
  "outputs": [
    { "name": "interpolated_frames", "type": "IMAGE", "required": true },
    { "name": "target_fps", "type": "FLOAT", "required": true },
    { "name": "interpolation_plan", "type": "CAUCE_FRAME_INTERPOLATION_PLAN", "required": true }
  ],
  "constraints": {
    "minimum_source_frames": 2,
    "output_frame_formula": "(source_frames - 1) * multiplier + 1",
    "target_fps_formula": "source_fps * multiplier",
    "preserves_source_samples": true,
    "preserves_first_to_last_sample_span": true,
    "semantic_regeneration": false,
    "audio_handling": "outside operation"
  },
  "graph_contract": [
    { "order": 1, "owner": "vanilla-comfy", "node_type": "GetVideoComponents", "role": "decode source video into frames and expose its exact frame rate" },
    { "order": 2, "owner": "cauce", "node_type": "CaucePlanFrameInterpolation", "role": "compute the exact endpoint-preserving output clock and count" },
    { "order": 3, "owner": "official-comfy", "node_type": "FrameInterpolationModelLoader", "role": "load a version-locked RIFE or FILM model from ComfyUI's native frame_interpolation model folder" },
    { "order": 4, "owner": "official-comfy", "node_type": "FrameInterpolate", "role": "interpolate every adjacent decoded frame pair while copying every source frame into its exact output anchor" },
    { "order": 5, "owner": "vanilla-comfy", "node_type": "CreateVideo", "role": "optionally rewrap interpolated frames at the planned target frame rate", "optional": true }
  ],
  "variants": [
    {
      "id": "rife-2x",
      "node_type": "FrameInterpolate",
      "multiplier": 2,
      "model_name": "rife_v4.26.safetensors",
      "source": "Comfy-Org/ComfyUI",
      "source_commit": "12d5279438bfefc058a269eae805ceab6047777f",
      "license": "MIT",
      "role": "practical default with arbitrary-timestep interpolation"
    },
    {
      "id": "film-2x",
      "node_type": "FrameInterpolate",
      "multiplier": 2,
      "model_name": "film_net_fp16.safetensors",
      "source": "Comfy-Org/ComfyUI",
      "source_commit": "12d5279438bfefc058a269eae805ceab6047777f",
      "license": "Apache-2.0",
      "role": "large-motion comparison path using recursive midpoint interpolation"
    }
  ],
  "artifacts": {
    "state": "contract-only",
    "pairs": []
  },
  "evidence": {
    "level": "schema-validated",
    "visual_verdict": "unassessed",
    "summary": "CAUCE output-clock algebra and ComfyUI 0.34.0's native endpoint-copying implementation were audited; live node availability, exact model files, and visual interpolation quality remain empirical gates."
  }
}
