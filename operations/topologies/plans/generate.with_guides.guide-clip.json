    { "key": "clip", "owner": "vanilla-comfy", "class_type": "CLIPLoader", "role": "load the H3 text encoder" },
    { "key": "video_vae", "owner": "vanilla-comfy", "class_type": "VAELoader", "role": "load the H3 video VAE" },
    { "key": "model", "owner": "vanilla-comfy", "class_type": "UNETLoader", "role": "load FL2VA" },
    { "key": "conditioning", "owner": "official-comfy", "class_type": "MiniMaxH3ImageToVideo", "role": "create base prompt conditioning and a fresh target" },
    { "key": "prepare_guide", "owner": "cauce", "class_type": "CauceH3PrepareGuideClip", "role": "make lattice trimming, fit, and resolved placement explicit" },
    { "key": "add_guide", "owner": "official-comfy", "class_type": "MiniMaxH3AddGuide", "role": "place the accepted guide clip at the resolved frame" },
    { "key": "sigma_shift", "owner": "official-comfy", "class_type": "MiniMaxH3SigmaShift", "role": "patch explicit flow shifts" },
