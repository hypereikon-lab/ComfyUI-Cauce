      "scheduler": "simple",
      "steps": 20,
      "cfg": 1.0,
      "parents_json": "[]"
    }
  },
  "23": {
    "class_type": "CauceSaveAVLatent",
    "inputs": {
      "latent": [
        "16",
        0
      ],
      "filename_prefix": "cauce/latents/{{window.id}}",
      "artifact_index": 1,
      "receipt": [
        "22",
        0
      ]
    }
  },
  "24": {
    "class_type": "CauceSaveReceipt",
    "inputs": {
      "receipt": [
        "22",
        0
      ],
