{
  "schema": "cauce.operation-topology/1",
  "operation": "regenerate.spatial",
  "operation_version": 1,
  "variant": "latent-second-pass",
  "state": "offline-draft",
  "basis": [
    { "source": "MiniMax-AI/MiniMax-H3", "path": "README.md", "section": "H3-Regenerate-2K" },
    { "source": "ComfyUI-Cauce", "path": "cauce/av_latent.py", "functions": ["resize_h3_av_latent"] }
  ],
  "nodes": [
    { "key": "source", "owner": "cauce", "class_type": "CauceLoadAVLatent", "role": "load source native H3 AV state" },
    { "key": "inspect", "owner": "cauce", "class_type": "CauceH3InspectAVLatent", "role": "validate source state" },
    { "key": "resize", "owner": "cauce", "class_type": "CauceH3ResizeAVLatent", "role": "resize visual latent only and attach bounded denoise masks" },
    { "key": "clip", "owner": "vanilla-comfy", "class_type": "CLIPLoader", "role": "load H3 text encoder" },
    { "key": "video_vae", "owner": "vanilla-comfy", "class_type": "VAELoader", "role": "load H3 video VAE" },
    { "key": "model", "owner": "vanilla-comfy", "class_type": "UNETLoader", "role": "load the same H3 checkpoint" },
    { "key": "conditioning", "owner": "official-comfy", "class_type": "MiniMaxH3ImageToVideo", "role": "rebuild conditioning at target geometry" },
    { "key": "sigma", "owner": "official-comfy", "class_type": "MiniMaxH3SigmaShift", "role": "set H3 shifts" },
    { "key": "noise", "owner": "vanilla-comfy", "class_type": "RandomNoise", "role": "bind seed" },
    { "key": "guider", "owner": "vanilla-comfy", "class_type": "BasicGuider", "role": "bind model and conditioning" },
    { "key": "scheduler", "owner": "vanilla-comfy", "class_type": "BasicScheduler", "role": "build partial-denoise sigmas" },
    { "key": "sampler", "owner": "vanilla-comfy", "class_type": "KSamplerSelect", "role": "select sampler" },
    { "key": "sample", "owner": "vanilla-comfy", "class_type": "SamplerCustomAdvanced", "role": "regenerate spatial detail with H3" },
    { "key": "clear", "owner": "cauce", "class_type": "CauceH3ClearAVDenoiseMask", "role": "clear consumed masks" },
    { "key": "decode", "owner": "vanilla-comfy", "class_type": "VAEDecode", "role": "decode regenerated frames" }
  ],
  "edges": [
    { "from": { "node": "source", "port": "latent" }, "to": { "node": "inspect", "port": "latent" } },
    { "from": { "node": "source", "port": "latent" }, "to": { "node": "resize", "port": "latent" } },
    { "from": { "node": "clip", "port": "CLIP" }, "to": { "node": "conditioning", "port": "clip" } },
    { "from": { "node": "video_vae", "port": "VAE" }, "to": { "node": "conditioning", "port": "vae" } },
    { "from": { "node": "model", "port": "MODEL" }, "to": { "node": "sigma", "port": "model" } },
    { "from": { "node": "sigma", "port": "MODEL" }, "to": { "node": "guider", "port": "model" } },
    { "from": { "node": "conditioning", "port": "positive" }, "to": { "node": "guider", "port": "conditioning" } },
    { "from": { "node": "sigma", "port": "MODEL" }, "to": { "node": "scheduler", "port": "model" } },
    { "from": { "node": "noise", "port": "NOISE" }, "to": { "node": "sample", "port": "noise" } },
    { "from": { "node": "guider", "port": "GUIDER" }, "to": { "node": "sample", "port": "guider" } },
    { "from": { "node": "sampler", "port": "SAMPLER" }, "to": { "node": "sample", "port": "sampler" } },
    { "from": { "node": "scheduler", "port": "SIGMAS" }, "to": { "node": "sample", "port": "sigmas" } },
    { "from": { "node": "resize", "port": "latent" }, "to": { "node": "sample", "port": "latent_image" } },
    { "from": { "node": "sample", "port": "output" }, "to": { "node": "clear", "port": "latent" } },
    { "from": { "node": "clear", "port": "latent" }, "to": { "node": "decode", "port": "samples" } },
    { "from": { "node": "video_vae", "port": "VAE" }, "to": { "node": "decode", "port": "vae" } }
  ],
  "bindings": [
    { "name": "source_path", "type": "STRING", "target": { "node": "source", "input": "path_or_folder" }, "required": true },
    { "name": "target_width", "type": "INT", "target": { "node": "resize", "input": "target_width" }, "required": true },
    { "name": "target_height", "type": "INT", "target": { "node": "resize", "input": "target_height" }, "required": true },
    { "name": "resize_method", "type": "STRING", "target": { "node": "resize", "input": "method" }, "required": true },
    { "name": "video_denoise", "type": "FLOAT", "target": { "node": "resize", "input": "video_denoise" }, "required": true },
    { "name": "audio_denoise", "type": "FLOAT", "target": { "node": "resize", "input": "audio_denoise" }, "required": true },
    { "name": "prompt", "type": "STRING", "target": { "node": "conditioning", "input": "prompt" }, "required": true },
    { "name": "condition_width", "type": "INT", "target": { "node": "conditioning", "input": "width" }, "required": true },
    { "name": "condition_height", "type": "INT", "target": { "node": "conditioning", "input": "height" }, "required": true },
    { "name": "frame_count", "type": "INT", "target": { "node": "conditioning", "input": "length" }, "required": true },
    { "name": "clear_origin", "type": "INT", "target": { "node": "clear", "input": "timeline_origin_frame" }, "required": true }
  ],
  "outputs": [
    { "name": "regenerated_native_av_latent", "type": "LATENT", "source": { "node": "clear", "port": "latent" } },
    { "name": "regenerated_frames", "type": "IMAGE", "source": { "node": "decode", "port": "IMAGE" } }
  ],
  "live_gates": [
    "run a denoise ladder at fixed seed",
    "verify target geometry and current H3 conditioning contract",
    "measure VRAM before increasing width, height, or duration",
    "score detail gain against identity and motion drift"
  ]
}
