{
  "schema": "cauce.operation-topology/1",
  "operation": "generate.with_guides",
  "operation_version": 3,
  "variant": "single-anchor",
  "state": "offline-draft",
  "basis": [
    { "source": "Comfy-Org/ComfyUI", "path": "comfy_extras/nodes_minimax_h3.py", "commit": "95d755cd8107a72258d452b5d3657273d571f07d" }
  ],
  "nodes": [
    { "key": "guide", "owner": "vanilla-comfy", "class_type": "LoadImage", "role": "load one decoded guide frame" },
    { "key": "clip", "owner": "vanilla-comfy", "class_type": "CLIPLoader", "role": "load the H3 text encoder" },
    { "key": "video_vae", "owner": "vanilla-comfy", "class_type": "VAELoader", "role": "load the H3 video VAE" },
    { "key": "model", "owner": "vanilla-comfy", "class_type": "UNETLoader", "role": "load FL2VA" },
    { "key": "conditioning", "owner": "official-comfy", "class_type": "MiniMaxH3ImageToVideo", "role": "create base prompt conditioning and a fresh target" },
    { "key": "add_guide", "owner": "official-comfy", "class_type": "MiniMaxH3AddGuide", "role": "place the only guide at one exact target-frame index" },
    { "key": "noise", "owner": "vanilla-comfy", "class_type": "RandomNoise", "role": "provide seed" },
    { "key": "guider", "owner": "vanilla-comfy", "class_type": "BasicGuider", "role": "bind guided conditioning" },
    { "key": "scheduler", "owner": "vanilla-comfy", "class_type": "BasicScheduler", "role": "construct sigmas" },
    { "key": "sampler", "owner": "vanilla-comfy", "class_type": "KSamplerSelect", "role": "select sampler" },
    { "key": "sample", "owner": "vanilla-comfy", "class_type": "SamplerCustomAdvanced", "role": "sample target" },
    { "key": "decode", "owner": "vanilla-comfy", "class_type": "VAEDecode", "role": "decode visual frames" }
  ],
  "edges": [
    { "from": { "node": "clip", "port": "CLIP" }, "to": { "node": "conditioning", "port": "clip" } },
    { "from": { "node": "video_vae", "port": "VAE" }, "to": { "node": "conditioning", "port": "vae" } },
    { "from": { "node": "conditioning", "port": "positive" }, "to": { "node": "add_guide", "port": "positive" } },
    { "from": { "node": "conditioning", "port": "LATENT" }, "to": { "node": "add_guide", "port": "latent" } },
    { "from": { "node": "video_vae", "port": "VAE" }, "to": { "node": "add_guide", "port": "vae" } },
    { "from": { "node": "guide", "port": "IMAGE" }, "to": { "node": "add_guide", "port": "image" } },
    { "from": { "node": "model", "port": "MODEL" }, "to": { "node": "guider", "port": "model" } },
    { "from": { "node": "add_guide", "port": "positive" }, "to": { "node": "guider", "port": "conditioning" } },
    { "from": { "node": "model", "port": "MODEL" }, "to": { "node": "scheduler", "port": "model" } },
    { "from": { "node": "noise", "port": "NOISE" }, "to": { "node": "sample", "port": "noise" } },
    { "from": { "node": "guider", "port": "GUIDER" }, "to": { "node": "sample", "port": "guider" } },
    { "from": { "node": "sampler", "port": "SAMPLER" }, "to": { "node": "sample", "port": "sampler" } },
    { "from": { "node": "scheduler", "port": "SIGMAS" }, "to": { "node": "sample", "port": "sigmas" } },
    { "from": { "node": "conditioning", "port": "LATENT" }, "to": { "node": "sample", "port": "latent_image" } },
    { "from": { "node": "sample", "port": "output" }, "to": { "node": "decode", "port": "samples" } },
    { "from": { "node": "video_vae", "port": "VAE" }, "to": { "node": "decode", "port": "vae" } }
  ],
  "bindings": [
    { "name": "guide_filename", "type": "STRING", "target": { "node": "guide", "input": "image" }, "required": true },
    { "name": "guide_frame", "type": "INT", "target": { "node": "add_guide", "input": "frame_idx" }, "required": true },
    { "name": "prompt", "type": "STRING", "target": { "node": "conditioning", "input": "prompt" }, "required": true },
    { "name": "width", "type": "INT", "target": { "node": "conditioning", "input": "width" }, "required": true },
    { "name": "height", "type": "INT", "target": { "node": "conditioning", "input": "height" }, "required": true },
    { "name": "target_frames", "type": "INT", "target": { "node": "conditioning", "input": "length" }, "required": true },
    { "name": "steps", "type": "INT", "target": { "node": "scheduler", "input": "steps" }, "required": true },
    { "name": "scheduler_name", "type": "STRING", "target": { "node": "scheduler", "input": "scheduler" }, "required": true },
    { "name": "sampler_name", "type": "STRING", "target": { "node": "sampler", "input": "sampler_name" }, "required": true },
    { "name": "seed", "type": "INT", "target": { "node": "noise", "input": "noise_seed" }, "required": true }
  ],
  "outputs": [
    { "name": "generated_frames", "type": "IMAGE", "source": { "node": "decode", "port": "IMAGE" } },
    { "name": "native_av_latent", "type": "LATENT", "source": { "node": "sample", "port": "output" } }
  ],
  "live_gates": [
    "confirm AddGuide schema and negative-index resolution",
    "confirm exactly one AddGuide node is present",
    "validate the guide range against the target",
    "export the paired graph, execute, and inspect reconstruction around the anchor"
  ]
}
