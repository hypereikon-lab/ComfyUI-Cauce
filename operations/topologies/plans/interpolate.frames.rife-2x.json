{
  "schema": "cauce.operation-topology/1",
  "operation": "interpolate.frames",
  "operation_version": 2,
  "variant": "rife-2x",
  "state": "offline-draft",
  "basis": [
    { "source": "Comfy-Org/ComfyUI", "commit": "12d5279438bfefc058a269eae805ceab6047777f", "path": "comfy_extras/nodes_frame_interpolation.py" },
    { "source": "Comfy-Org/frame_interpolation", "commit": "9bca6366a22473ccee25602fa82b224d78413960", "path": "frame_interpolation/rife_v4.26.safetensors" },
    { "source": "ComfyUI-Cauce", "path": "cauce/temporal.py", "version": "5.4.2" }
  ],
  "nodes": [
    { "key": "source", "owner": "vanilla-comfy", "class_type": "GetVideoComponents", "role": "decode source video and expose frames plus fps" },
    { "key": "plan", "owner": "cauce", "class_type": "CaucePlanFrameInterpolation", "role": "calculate exact target count, fps, and source anchor positions" },
    { "key": "model", "owner": "official-comfy", "class_type": "FrameInterpolationModelLoader", "role": "load the native ComfyUI RIFE v4.26 checkpoint" },
    { "key": "interpolate", "owner": "official-comfy", "class_type": "FrameInterpolate", "role": "synthesize multiplier minus one frames between every source pair" }
  ],
  "edges": [
    { "from": { "node": "source", "port": "images" }, "to": { "node": "interpolate", "port": "images" } },
    { "from": { "node": "model", "port": "INTERP_MODEL" }, "to": { "node": "interpolate", "port": "interp_model" } },
    { "from": { "node": "plan", "port": "resolved_multiplier" }, "to": { "node": "interpolate", "port": "multiplier" } }
  ],
  "bindings": [
    { "name": "source_video", "type": "VIDEO", "target": { "node": "source", "input": "video" }, "required": true },
    { "name": "source_frame_count", "type": "INT", "target": { "node": "plan", "input": "source_frame_count" }, "required": true },
    { "name": "source_fps", "type": "FLOAT", "target": { "node": "plan", "input": "source_fps" }, "required": true },
    { "name": "multiplier", "type": "INT", "target": { "node": "plan", "input": "multiplier" }, "required": true },
    { "name": "model_name", "type": "COMBO", "target": { "node": "model", "input": "model_name" }, "required": true }
  ],
  "outputs": [
    { "name": "interpolated_frames", "type": "IMAGE", "source": { "node": "interpolate", "port": "IMAGE" } },
    { "name": "target_fps", "type": "FLOAT", "source": { "node": "plan", "port": "target_fps" } },
    { "name": "interpolation_plan", "type": "CAUCE_FRAME_INTERPOLATION_PLAN", "source": { "node": "plan", "port": "plan" } }
  ],
  "live_gates": [
    "verify ComfyUI 0.34.0 or newer and the native FrameInterpolationModelLoader / FrameInterpolate object_info contracts",
    "verify the exact rife_v4.26.safetensors filename and hash before queueing",
    "derive source_frame_count from the decoded batch and reject mismatches before queueing",
    "confirm the emitted count equals (N - 1) * multiplier + 1 and original frames occupy every multiplier-th output index",
    "save or rewrap at target_fps only after the count assertion passes"
  ]
}
