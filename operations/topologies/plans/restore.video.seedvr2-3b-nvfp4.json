{
  "schema": "cauce.operation-topology/1",
  "operation": "restore.video",
  "operation_version": 2,
  "variant": "seedvr2-3b-nvfp4",
  "state": "offline-draft",
  "basis": [
    { "source": "Comfy-Org/workflow_templates", "commit": "d11b69157009227ad2a7d3a927a1eb68a3d5f281", "path": "templates/utility_seedvr2_3b_int8_upscale_video.json" },
    { "source": "Comfy-Org/ComfyUI", "commit": "12d5279438bfefc058a269eae805ceab6047777f", "path": "comfy_extras/nodes_seedvr.py" },
    { "source": "Comfy-Org/SeedVR2", "commit": "673340c8a66db62b84e4099def7d01d337ae12dc", "path": "diffusion_models/seedvr2_3b_nvfp4.safetensors" },
    { "source": "Comfy-Org/SeedVR2", "commit": "673340c8a66db62b84e4099def7d01d337ae12dc", "path": "vae/ema_vae_fp16.safetensors" }
  ],
  "nodes": [
    { "key": "source", "owner": "vanilla-comfy", "class_type": "GetVideoComponents", "role": "decode source frames and preserve original fps" },
    { "key": "resize", "owner": "vanilla-comfy", "class_type": "ResizeImageMaskNode", "role": "resize source frames to the requested output geometry" },
    { "key": "model", "owner": "vanilla-comfy", "class_type": "UNETLoader", "role": "load the version-locked SeedVR2 3B NVFP4 model" },
    { "key": "vae", "owner": "vanilla-comfy", "class_type": "VAELoader", "role": "load the version-locked SeedVR2 VAE" },
    { "key": "preprocess", "owner": "official-comfy", "class_type": "SeedVR2Preprocess", "role": "pad the resized frame batch for SeedVR2 encoding" },
    { "key": "encode", "owner": "vanilla-comfy", "class_type": "VAEEncodeTiled", "role": "encode video with bounded spatial and temporal tiles" },
    { "key": "chunk", "owner": "official-comfy", "class_type": "SeedVR2TemporalChunk", "role": "split encoded video into overlapping temporal chunks" },
    { "key": "condition", "owner": "official-comfy", "class_type": "SeedVR2Conditioning", "role": "create native SeedVR2 conditioning for the active chunk" },
    { "key": "sample", "owner": "vanilla-comfy", "class_type": "KSampler", "role": "run one-step restoration over each chunk" },
    { "key": "merge", "owner": "official-comfy", "class_type": "SeedVR2TemporalMerge", "role": "merge sampled chunks with an overlap crossfade" },
    { "key": "decode", "owner": "vanilla-comfy", "class_type": "VAEDecodeTiled", "role": "decode restored latent chunks" },
    { "key": "postprocess", "owner": "official-comfy", "class_type": "SeedVR2PostProcessing", "role": "align output geometry and apply color correction" }
  ],
  "edges": [
    { "from": { "node": "source", "port": "images" }, "to": { "node": "resize", "port": "input" } },
    { "from": { "node": "resize", "port": "resized" }, "to": { "node": "preprocess", "port": "resized_images" } },
    { "from": { "node": "preprocess", "port": "images" }, "to": { "node": "encode", "port": "pixels" } },
    { "from": { "node": "vae", "port": "VAE" }, "to": { "node": "encode", "port": "vae" } },
    { "from": { "node": "encode", "port": "LATENT" }, "to": { "node": "chunk", "port": "latent" } },
    { "from": { "node": "model", "port": "MODEL" }, "to": { "node": "condition", "port": "model" } },
    { "from": { "node": "chunk", "port": "latents" }, "to": { "node": "condition", "port": "vae_conditioning" } },
    { "from": { "node": "model", "port": "MODEL" }, "to": { "node": "sample", "port": "model" } },
    { "from": { "node": "condition", "port": "positive" }, "to": { "node": "sample", "port": "positive" } },
    { "from": { "node": "condition", "port": "negative" }, "to": { "node": "sample", "port": "negative" } },
    { "from": { "node": "chunk", "port": "latents" }, "to": { "node": "sample", "port": "latent_image" } },
    { "from": { "node": "sample", "port": "LATENT" }, "to": { "node": "merge", "port": "latents" } },
    { "from": { "node": "chunk", "port": "temporal_overlap" }, "to": { "node": "merge", "port": "temporal_overlap" } },
    { "from": { "node": "merge", "port": "latent" }, "to": { "node": "decode", "port": "samples" } },
    { "from": { "node": "vae", "port": "VAE" }, "to": { "node": "decode", "port": "vae" } },
    { "from": { "node": "decode", "port": "IMAGE" }, "to": { "node": "postprocess", "port": "images" } },
    { "from": { "node": "resize", "port": "resized" }, "to": { "node": "postprocess", "port": "original_resized_images" } }
  ],
  "bindings": [
    { "name": "source_video", "type": "VIDEO", "target": { "node": "source", "input": "video" }, "required": true },
    { "name": "scale_multiplier", "type": "FLOAT", "target": { "node": "resize", "input": "resize_type.multiplier" }, "required": true },
    { "name": "unet_name", "type": "COMBO", "target": { "node": "model", "input": "unet_name" }, "required": true },
    { "name": "vae_name", "type": "COMBO", "target": { "node": "vae", "input": "vae_name" }, "required": true },
    { "name": "temporal_overlap", "type": "INT", "target": { "node": "chunk", "input": "temporal_overlap" }, "required": true },
    { "name": "chunking_mode", "type": "COMBO", "target": { "node": "chunk", "input": "chunking_mode" }, "required": true },
    { "name": "seed", "type": "INT", "target": { "node": "sample", "input": "seed" }, "required": true },
    { "name": "steps", "type": "INT", "target": { "node": "sample", "input": "steps" }, "required": true },
    { "name": "cfg", "type": "FLOAT", "target": { "node": "sample", "input": "cfg" }, "required": true },
    { "name": "sampler_name", "type": "COMBO", "target": { "node": "sample", "input": "sampler_name" }, "required": true },
    { "name": "scheduler", "type": "COMBO", "target": { "node": "sample", "input": "scheduler" }, "required": true },
    { "name": "denoise", "type": "FLOAT", "target": { "node": "sample", "input": "denoise" }, "required": true },
    { "name": "color_correction_method", "type": "COMBO", "target": { "node": "postprocess", "input": "color_correction_method" }, "required": true }
  ],
  "outputs": [
    { "name": "restored_frames", "type": "IMAGE", "source": { "node": "postprocess", "port": "images" } },
    { "name": "source_fps", "type": "FLOAT", "source": { "node": "source", "port": "fps" } }
  ],
  "live_gates": [
    "confirm all native SeedVR2 node contracts through live object_info",
    "confirm seedvr2_3b_nvfp4.safetensors and ema_vae_fp16.safetensors plus their locked SHA-256 values before queueing",
    "start with automatic chunk sizing and a conservative temporal overlap, then record actual 32 GB VRAM behavior",
    "assert output frame count equals input frame count and fps remains unchanged",
    "inspect temporal stability, texture invention, color correction, and chunk-boundary behavior before acceptance",
    "retain at least the configured storage reserve before downloading model weights or saving outputs"
  ]
