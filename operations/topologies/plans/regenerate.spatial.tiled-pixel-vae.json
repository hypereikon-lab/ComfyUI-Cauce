{
  "schema": "cauce.operation-topology/1",
  "operation": "regenerate.spatial",
  "operation_version": 2,
  "variant": "tiled-pixel-vae",
  "state": "offline-draft",
  "basis": [
    { "source": "MiniMax-AI/MiniMax-H3", "path": "README.md", "section": "H3-Regenerate-2K" },
    { "source": "arXiv:2603.17555", "role": "overlapping tiled diffusion with a low-resolution global prior" },
    { "source": "ComfyUI-Cauce", "path": "cauce/av_latent.py", "functions": ["replace_h3_video_stream"] }
  ],
  "nodes": [
    { "key": "source", "owner": "cauce", "class_type": "CauceLoadAVLatent", "role": "load source native H3 AV state" },
    { "key": "inspect", "owner": "cauce", "class_type": "CauceH3InspectAVLatent", "role": "validate source state" },
    { "key": "clip", "owner": "vanilla-comfy", "class_type": "CLIPLoader", "role": "load H3 text encoder" },
    { "key": "video_vae", "owner": "vanilla-comfy", "class_type": "VAELoader", "role": "load H3 video VAE" },
    { "key": "model", "owner": "vanilla-comfy", "class_type": "UNETLoader", "role": "load the same H3 checkpoint" },
    { "key": "source_decode", "owner": "vanilla-comfy", "class_type": "VAEDecode", "role": "decode source visual state" },
    { "key": "global_upscale", "owner": "vanilla-comfy", "class_type": "ImageScale", "role": "construct deterministic full-resolution global prior" },
    { "key": "tile_split", "owner": "vanilla-comfy", "class_type": null, "role": "split every frame into deterministic overlapping spatial tiles with recorded coordinates" },
    { "key": "tile_encode", "owner": "vanilla-comfy", "class_type": "VAEEncode", "role": "encode one full temporal tile through the H3 VAE" },
    { "key": "replace_tile", "owner": "cauce", "class_type": "CauceH3ReplaceVisualStream", "role": "graft each encoded tile onto the source AV carrier" },
    { "key": "conditioning", "owner": "official-comfy", "class_type": "MiniMaxH3ImageToVideo", "role": "build tile-geometry conditioning" },
    { "key": "noise", "owner": "vanilla-comfy", "class_type": "RandomNoise", "role": "bind a deterministic per-tile seed schedule" },
    { "key": "guider", "owner": "vanilla-comfy", "class_type": "BasicGuider", "role": "bind model and conditioning" },
    { "key": "scheduler", "owner": "vanilla-comfy", "class_type": "BasicScheduler", "role": "build partial-denoise sigmas" },
    { "key": "sampler", "owner": "vanilla-comfy", "class_type": "KSamplerSelect", "role": "select sampler" },
    { "key": "sample", "owner": "vanilla-comfy", "class_type": "SamplerCustomAdvanced", "role": "regenerate every tile with the same H3 model" },
    { "key": "clear", "owner": "cauce", "class_type": "CauceH3ClearAVDenoiseMask", "role": "clear each tile mask after sampling" },
    { "key": "tile_decode", "owner": "vanilla-comfy", "class_type": "VAEDecode", "role": "decode regenerated tile frames" },
    { "key": "tile_merge", "owner": "vanilla-comfy", "class_type": null, "role": "feather overlapping tiles into one full-resolution frame batch" },
    { "key": "final_encode", "owner": "vanilla-comfy", "class_type": "VAEEncode", "role": "encode the feathered result as one H3 visual stream" },
    { "key": "replace_final", "owner": "cauce", "class_type": "CauceH3ReplaceVisualStream", "role": "repack the composited high-resolution visual stream with source structural audio" },
    { "key": "clear_final", "owner": "cauce", "class_type": "CauceH3ClearAVDenoiseMask", "role": "remove the unused final graft mask" }
  ],
  "edges": [
    { "from": { "node": "source", "port": "latent" }, "to": { "node": "inspect", "port": "latent" } },
    { "from": { "node": "source", "port": "latent" }, "to": { "node": "source_decode", "port": "samples" } },
    { "from": { "node": "video_vae", "port": "VAE" }, "to": { "node": "source_decode", "port": "vae" } },
    { "from": { "node": "source_decode", "port": "IMAGE" }, "to": { "node": "global_upscale", "port": "image" } },
    { "from": { "node": "global_upscale", "port": "IMAGE" }, "to": { "node": "tile_split", "port": "images" } },
    { "from": { "node": "tile_split", "port": "tile_images" }, "to": { "node": "tile_encode", "port": "pixels" } },
    { "from": { "node": "video_vae", "port": "VAE" }, "to": { "node": "tile_encode", "port": "vae" } },
    { "from": { "node": "source", "port": "latent" }, "to": { "node": "replace_tile", "port": "target_av_latent" } },
    { "from": { "node": "tile_encode", "port": "LATENT" }, "to": { "node": "replace_tile", "port": "encoded_video_latent" } },
    { "from": { "node": "clip", "port": "CLIP" }, "to": { "node": "conditioning", "port": "clip" } },
    { "from": { "node": "video_vae", "port": "VAE" }, "to": { "node": "conditioning", "port": "vae" } },
    { "from": { "node": "model", "port": "MODEL" }, "to": { "node": "guider", "port": "model" } },
    { "from": { "node": "conditioning", "port": "positive" }, "to": { "node": "guider", "port": "conditioning" } },
    { "from": { "node": "model", "port": "MODEL" }, "to": { "node": "scheduler", "port": "model" } },
    { "from": { "node": "noise", "port": "NOISE" }, "to": { "node": "sample", "port": "noise" } },
    { "from": { "node": "guider", "port": "GUIDER" }, "to": { "node": "sample", "port": "guider" } },
    { "from": { "node": "sampler", "port": "SAMPLER" }, "to": { "node": "sample", "port": "sampler" } },
    { "from": { "node": "scheduler", "port": "SIGMAS" }, "to": { "node": "sample", "port": "sigmas" } },
    { "from": { "node": "replace_tile", "port": "latent" }, "to": { "node": "sample", "port": "latent_image" } },
    { "from": { "node": "sample", "port": "output" }, "to": { "node": "clear", "port": "latent" } },
    { "from": { "node": "clear", "port": "latent" }, "to": { "node": "tile_decode", "port": "samples" } },
    { "from": { "node": "video_vae", "port": "VAE" }, "to": { "node": "tile_decode", "port": "vae" } },
    { "from": { "node": "tile_decode", "port": "IMAGE" }, "to": { "node": "tile_merge", "port": "tile_images" } },
    { "from": { "node": "tile_split", "port": "tile_layout" }, "to": { "node": "tile_merge", "port": "tile_layout" } },
    { "from": { "node": "tile_merge", "port": "images" }, "to": { "node": "final_encode", "port": "pixels" } },
    { "from": { "node": "video_vae", "port": "VAE" }, "to": { "node": "final_encode", "port": "vae" } },
    { "from": { "node": "source", "port": "latent" }, "to": { "node": "replace_final", "port": "target_av_latent" } },
    { "from": { "node": "final_encode", "port": "LATENT" }, "to": { "node": "replace_final", "port": "encoded_video_latent" } },
    { "from": { "node": "replace_final", "port": "latent" }, "to": { "node": "clear_final", "port": "latent" } }
  ],
  "bindings": [
    { "name": "source_path", "type": "STRING", "target": { "node": "source", "input": "path_or_folder" }, "required": true },
    { "name": "target_width", "type": "INT", "target": { "node": "global_upscale", "input": "width" }, "required": true },
    { "name": "target_height", "type": "INT", "target": { "node": "global_upscale", "input": "height" }, "required": true },
    { "name": "tile_width", "type": "INT", "target": { "node": "tile_split", "input": "tile_width" }, "required": true },
    { "name": "tile_height", "type": "INT", "target": { "node": "tile_split", "input": "tile_height" }, "required": true },
    { "name": "tile_overlap", "type": "INT", "target": { "node": "tile_split", "input": "overlap" }, "required": true },
    { "name": "video_denoise", "type": "FLOAT", "target": { "node": "replace_tile", "input": "video_denoise" }, "required": true },
    { "name": "audio_denoise", "type": "FLOAT", "target": { "node": "replace_tile", "input": "audio_denoise" }, "required": true },
    { "name": "prompt", "type": "STRING", "target": { "node": "conditioning", "input": "prompt" }, "required": true },
    { "name": "tile_condition_width", "type": "INT", "target": { "node": "conditioning", "input": "width" }, "required": true },
    { "name": "tile_condition_height", "type": "INT", "target": { "node": "conditioning", "input": "height" }, "required": true },
    { "name": "frame_count", "type": "INT", "target": { "node": "conditioning", "input": "length" }, "required": true },
    { "name": "clear_origin", "type": "INT", "target": { "node": "clear", "input": "timeline_origin_frame" }, "required": true },
    { "name": "final_video_denoise", "type": "FLOAT", "target": { "node": "replace_final", "input": "video_denoise" }, "required": true },
    { "name": "final_audio_denoise", "type": "FLOAT", "target": { "node": "replace_final", "input": "audio_denoise" }, "required": true },
    { "name": "final_clear_origin", "type": "INT", "target": { "node": "clear_final", "input": "timeline_origin_frame" }, "required": true }
  ],
  "outputs": [
    { "name": "regenerated_native_av_latent", "type": "LATENT", "source": { "node": "clear_final", "port": "latent" } },
    { "name": "regenerated_frames", "type": "IMAGE", "source": { "node": "tile_merge", "port": "images" } }
  ],
  "live_gates": [
    "materialize tile split and feather merge only from node contracts available on the target ComfyUI build",
    "prove overlap seams are lower than the non-tiled baseline",
    "hold a shared global prior, prompt, denoise, and deterministic seed schedule across tiles",
    "benchmark tile size, overlap, runtime, and VRAM on the 32 GB RTX 5090"
  ]
}
